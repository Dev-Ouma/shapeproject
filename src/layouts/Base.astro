---
import { loadSite } from '../lib/content';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Lucide from '../components/Lucide.astro';
import { safeJson } from '../lib/json';
import { breadcrumbs, websiteLd, organizationLd } from '../lib/seo';
import { getMaintenance } from '../lib/system';
const staffMaintenance = !!Astro.locals.user && getMaintenance().on;
const { contact, nav, socials, disclaimer, footerText } = loadSite();

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  readingMinutes?: number;
  noindex?: boolean;
  /** Extra schema.org objects for this page (articles, events...). */
  jsonLd?: object[];
}

const {
  title,
  description = 'Smart City Higher Education Advancement Program in East Africa — an Erasmus+ CBHE project.',
  image = '/images/slider1.png',
  type = 'website',
  published,
  modified,
  readingMinutes,
  noindex = false,
  jsonLd = [],
} = Astro.props;
const site = Astro.site ?? new URL('https://shapeproject.ouk.ac.ke');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const crumbs = noindex ? null : breadcrumbs(Astro.url.pathname, title, site);
const structured = [
  organizationLd(site, socials.map((s) => s.href), contact),
  ...(Astro.url.pathname === '/' ? [websiteLd(site)] : []),
  ...(crumbs ? [crumbs] : []),
  ...jsonLd,
];
const verifyGoogle = import.meta.env.GOOGLE_SITE_VERIFICATION ?? process.env.GOOGLE_SITE_VERIFICATION;
const verifyBing = import.meta.env.BING_SITE_VERIFICATION ?? process.env.BING_SITE_VERIFICATION;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const fullTitle = title === 'Home' ? 'SHAPE Project — Smart City Higher Education in East Africa' : `${title} - SHAPE Project`;

const searchIndex = [
  { title: 'Home', href: '/' },
  { title: 'About SHAPE', href: '/about/' },
  { title: 'Thematic Areas', href: '/about/#thematic' },
  { title: 'Target Groups', href: '/about/#target-groups' },
  { title: 'Expected Project Impacts', href: '/about/#impacts' },
  { title: 'Partners', href: '/partners/' },
  { title: 'Project Team', href: '/project-team/' },
  { title: 'Work Packages', href: '/deliverables/' },
  { title: 'Deliverables', href: '/deliverables/#deliverables-list' },
  { title: 'Materials', href: '/materials/' },
  { title: 'Events', href: '/events/' },
  { title: 'News', href: '/news/' },
  { title: 'Executive Brief (PDF)', href: '/project-book/' },
  { title: 'Contact', href: '/contact/' },
];
const tel = contact.phone.replace(/[^+\d]/g, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    {verifyGoogle && <meta name="google-site-verification" content={verifyGoogle} />}
    {verifyBing && <meta name="msvalidate.01" content={verifyBing} />}
    <meta name="theme-color" content="#037b90" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SHAPE Project" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title === 'Home' ? 'SHAPE Project' : title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@shapeprojecteu" />
    <meta name="twitter:site" content="@shapeprojecteu" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {readingMinutes && <meta name="twitter:label1" content="Est. reading time" />}
    {readingMinutes && <meta name="twitter:data1" content={`${readingMinutes} minute${readingMinutes > 1 ? 's' : ''}`} />}
    <link rel="alternate" type="application/rss+xml" title="SHAPE Project » Feed" href="/feed.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/images/cropped-SHAPE-final-Logo-32x32.jpeg" sizes="32x32" />
    <link rel="icon" href="/images/cropped-SHAPE-final-Logo-192x192.jpeg" sizes="192x192" />
    <link rel="apple-touch-icon" href="/images/cropped-SHAPE-final-Logo-180x180.jpeg" />
    {structured.map((ld) => <script type="application/ld+json" set:html={safeJson(ld)} />)}
    <script is:inline src="/js/boot.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Poppins:wght@500;600;700;800&family=Roboto:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    {staffMaintenance && <div class="preview-bar" role="status" style="background:#037b90;color:#fff">Maintenance mode is on — visitors see the maintenance page. You are seeing the live site because you are signed in. <a href="/admin/system/modes" style="color:#fff;text-decoration:underline">Manage</a></div>}
    <div class="preloader" data-preloader role="status" aria-label="Loading">
      <div class="preloader__inner">
        <span class="preloader__ring"></span>
        <img src="/images/cropped-SHAPE-final-Logo-192x192.jpeg" alt="" width="70" height="70" />
        <span class="preloader__text">Loading<span class="preloader__dots"></span></span>
      </div>
    </div>
    <a class="skip" href="#content">Skip to content</a>

    <div class="topbar">
      <div class="container topbar__inner">
        <ul class="topbar__contact">
          <li><a href={`tel:${tel}`}><Lucide name="Phone" size={15} /> {contact.phone}</a></li>
          <li><a href={`mailto:${contact.email}`}><Lucide name="Mail" size={15} /> {contact.email}</a></li>
        </ul>
        <ul class="social">
          {socials.map((s) => (
            <li><a href={s.href} aria-label={s.name} target="_blank" rel="noopener"><Icon name={s.icon} /></a></li>
          ))}
        </ul>
      </div>
    </div>

    <header class="header" data-header>
      <div class="container header__inner">
        <a href="/" class="header__logo" aria-label="SHAPE Project home">
          <img src="/images/Shape-and-EU-scaled.png" alt="SHAPE — co-funded by the Erasmus+ Programme of the European Union" width="2560" height="393" />
        </a>
        <div class="header__right">
          <nav id="site-nav" class="nav" data-nav aria-label="Main">
            <ul>
              {nav.map((item) => (
                <li class:list={[{ 'has-children': item.children, active: isActive(item.href) && !(item.children && item.children.some((c) => c.href !== item.href && isActive(c.href))) }]}>
                  <a href={item.href}>{item.label}{item.children && <Lucide name="ChevronDown" size={14} />}</a>
                  {item.children && (
                    <ul class="submenu">
                      {item.children.map((c) => <li class:list={[{ active: path === c.href }]}><a href={c.href}>{c.label}</a></li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
          <button class="search-btn" type="button" aria-label="Search" data-search-open><Lucide name="Search" size={18} /></button>
          <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
            <span class="sr-only">Menu</span><span class="nav-toggle__bars"></span>
          </button>
        </div>
      </div>
    </header>

    <dialog class="search-modal" data-search-dialog>
      <form method="get" action="/search/" role="search" class="search-modal__box">
        <button class="search-modal__close" type="button" aria-label="Close search" data-search-close>×</button>
        <label class="search-modal__field">
          <Lucide name="Search" size={20} />
          <input type="search" name="s" placeholder="Search..." aria-label="Search the site" data-search-input autocomplete="off" />
        </label>
        <ul class="search-modal__results" data-search-results>
          {searchIndex.map((r) => <li><a href={r.href}>{r.title}</a></li>)}
        </ul>
      </form>
    </dialog>

    <main id="content">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__grid">
        <div class="footer__brand">
          <img class="footer__logo" src="/images/White-SHAPE-final-Logo-1-1024x431.png" alt="SHAPE — Smart City Higher Education Advancement Programme in East Africa" width="1024" height="431" loading="lazy" />
          <p>{footerText}</p>
        </div>
        <div>
          <h3>Pages</h3>
          <ul class="footer__links">
            <li><a href="/about/">About SHAPE</a></li>
          </ul>
        </div>
        <div class="footer__eu">
          <img src="/images/EU-scaled.png" alt="Co-funded by the Erasmus+ Programme of the European Union" width="2560" height="752" loading="lazy" />
          <p class="footer__disclaimer">{disclaimer}</p>
        </div>
        <div class="footer__img">
          <img src="/images/projabout-300x300.png" alt="" width="300" height="300" loading="lazy" />
        </div>
      </div>
      <div class="container footer__host">
        <span>Website hosted and maintained by</span>
        <a href="https://ouk.ac.ke/" target="_blank" rel="noopener" aria-label="Open University of Kenya"><img src="/images/ouk-logo.png" alt="Open University of Kenya" width="1080" height="600" loading="lazy" /></a>
      </div>
      <div class="footer__bottom">
        <div class="container">Copyright © {new Date().getFullYear()} SHAPE Project. All Rights Reserved</div>
      </div>
    </footer>

    <script>
      import '../scripts/motion';
      import '../scripts/analytics';
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });

      const header = document.querySelector('[data-header]');
      const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 40);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const results = [...document.querySelectorAll<HTMLLIElement>('[data-search-results] li')];
      document.querySelector('[data-search-open]')?.addEventListener('click', () => {
        dialog?.showModal();
        input?.focus();
      });
      document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      let searchTimer: number | undefined;
      let lastSearch = '';
      const reportSearch = () => {
        const q = input?.value.trim().toLowerCase() ?? '';
        if (q.length < 2 || q === lastSearch) return;
        lastSearch = q;
        dispatchEvent(new CustomEvent('shape:search', { detail: { q, results: results.filter((li) => !li.hidden).length } }));
      };
      input?.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        results.forEach((li) => (li.hidden = !!q && !li.textContent!.toLowerCase().includes(q)));
        clearTimeout(searchTimer);
        searchTimer = window.setTimeout(reportSearch, 1200);
      });
      dialog?.addEventListener('close', reportSearch);
    </script>
  </body>
</html>
