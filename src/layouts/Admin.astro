---
import '../styles/admin.css';
import Lucide from '../components/Lucide.astro';
import { collections } from '../lib/schema';
import { can } from '../lib/auth';
import { countPendingComments, countUnreadMessages } from '../lib/engagement';
import { getMaintenance, getLockdown } from '../lib/system';
import { currentRelease } from '../lib/sysinfo';
import { countTrash } from '../lib/trash';

interface Props {
  title: string;
  crumbs?: { label: string; href?: string }[];
}
const { title, crumbs = [] } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname;
const isAdmin = can(user, 'admin');
const groups = ['Site', 'Home', 'About', 'Programme', 'People', 'Library', 'News'] as const;
const pending = countPendingComments();
const unread = countUnreadMessages();
const maintenance = getMaintenance();
const lockdown = getLockdown();
const release = currentRelease();
const binCount = countTrash();
const active = (href: string) => (href === '/admin' ? path === '/admin' || path === '/admin/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · SHAPE CMS</title>
    <script is:inline src="/js/admin-boot.js"></script>
    <link rel="icon" href="/images/cropped-SHAPE-final-Logo-32x32.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="admin" data-idle-ends={Astro.locals.idleEndsAt}>
    <div class="a-shell">
      <aside class="a-side" id="admin-side" data-side aria-label="Admin navigation">
        <button class="a-side__close" type="button" data-side-close aria-label="Close menu"><Lucide name="X" size={18} /></button>
        <a class="a-brand" href="/admin">
          <img src="/images/cropped-SHAPE-final-Logo-192x192.jpeg" alt="" />
          <div><strong>SHAPE CMS</strong><span>Content management</span></div>
        </a>
        <nav class="a-nav">
          <a href="/admin" title="Dashboard" class:list={{ 'is-active': active('/admin') }}><Lucide name="LayoutDashboard" size={17} /> <span class="a-nav__t">Dashboard</span></a>
          <a href="/" title="View site" target="_blank" rel="noopener"><Lucide name="ExternalLink" size={17} /> <span class="a-nav__t">View site</span></a>
          {groups.map((g) => {
            const items = collections.filter((c) => c.group === g && (!c.adminOnly || isAdmin));
            return items.length > 0 && (
              <Fragment>
                <h4>{g}</h4>
                {items.map((c) => (
                  <a title={c.label} href={`/admin/content/${c.key}`} class:list={{ 'is-active': active(`/admin/content/${c.key}`) }}><Lucide name={c.icon as any} size={17} /> <span class="a-nav__t">{c.label}</span></a>
                ))}
              </Fragment>
            );
          })}
          <h4>Engagement</h4>
          <a href="/admin/analytics" title="Analytics" class:list={{ 'is-active': active('/admin/analytics') }}><Lucide name="ChartSpline" size={17} /> <span class="a-nav__t">Analytics</span></a>
          <a href="/admin/comments" title="Comments" class:list={{ 'is-active': active('/admin/comments') }}><Lucide name="MessageSquare" size={17} /> <span class="a-nav__t">Comments</span> {pending > 0 && <span class="a-badge">{pending}</span>}</a>
          <a href="/admin/messages" title="Inbox" class:list={{ 'is-active': active('/admin/messages') }}><Lucide name="Inbox" size={17} /> <span class="a-nav__t">Inbox</span> {unread > 0 && <span class="a-badge">{unread}</span>}</a>
          <h4>Tools</h4>
          <a href="/admin/media" title="Media library" class:list={{ 'is-active': active('/admin/media') }}><Lucide name="Image" size={17} /> <span class="a-nav__t">Media library</span></a>
          <a href="/admin/book" title="Project Book PDF" class:list={{ 'is-active': active('/admin/book') }}><Lucide name="BookOpen" size={17} /> <span class="a-nav__t">Project Book PDF</span></a>
          <a href="/admin/account" title="My account" class:list={{ 'is-active': active('/admin/account') }}><Lucide name="KeyRound" size={17} /> <span class="a-nav__t">My account</span></a>
          <h4>Administration</h4>
          {isAdmin && <a href="/admin/system" title="Overview" class:list={{ 'is-active': path === '/admin/system' || path === '/admin/system/' }}><Lucide name="Gauge" size={17} /> <span class="a-nav__t">Overview</span></a>}
          {isAdmin && <a href="/admin/audit" title="Audit trail" class:list={{ 'is-active': active('/admin/audit') }}><Lucide name="ScrollText" size={17} /> <span class="a-nav__t">Audit trail</span></a>}
          <a href="/admin/trash" title="Recycle bin" class:list={{ 'is-active': active('/admin/trash') }}><Lucide name="Recycle" size={17} /> <span class="a-nav__t">Recycle bin</span> {binCount > 0 && <span class="a-badge a-badge--muted">{binCount}</span>}</a>
          {isAdmin && <a href="/admin/content/releases" title="Release notes" class:list={{ 'is-active': active('/admin/content/releases') }}><Lucide name="Rocket" size={17} /> <span class="a-nav__t">Release notes</span></a>}
          <a href="/admin/releases" title="What’s new" class:list={{ 'is-active': active('/admin/releases') }}><Lucide name="Sparkles" size={17} /> <span class="a-nav__t">What’s new</span></a>
          {isAdmin && <a href="/admin/system/modes" title="Maintenance & lockdown" class:list={{ 'is-active': active('/admin/system/modes') }}><Lucide name="ShieldAlert" size={17} /> <span class="a-nav__t">Maintenance & lockdown</span> {(maintenance.on || lockdown.on) && <span class="a-badge">!</span>}</a>}
          {isAdmin && <a href="/admin/users" title="Users" class:list={{ 'is-active': active('/admin/users') }}><Lucide name="UserCog" size={17} /> <span class="a-nav__t">Users</span></a>}
        </nav>
        {release && <a class="a-version" href={`/admin/releases#v${release.version}`} title={`Version ${release.version}: ${release.title}`}><Lucide name="Rocket" size={14} /> <span class="a-nav__t">SHAPE CMS v{release.version}</span></a>}
      </aside>
      <div class="a-scrim" data-scrim hidden></div>
      <dialog class="a-idle" data-idle aria-labelledby="idle-title">
        <h2 id="idle-title">Still there?</h2>
        <p>For security you will be signed out in <strong data-idle-count>5:00</strong> because there has been no activity.</p>
        <div class="a-idle__bar">
          <form method="post" action="/admin/logout"><button class="a-btn a-btn--ghost" type="submit">Sign out now</button></form>
          <button class="a-btn" type="button" data-idle-stay>Stay signed in</button>
        </div>
      </dialog>
      <div class="a-main">
        <header class="a-top">
          <div style="display:flex;align-items:center;gap:10px">
            <button class="a-btn a-btn--ghost a-btn--sm a-collapse-btn" type="button" data-collapse aria-label="Collapse sidebar" aria-expanded="true" title="Toggle sidebar ( [ )" aria-controls="admin-side"><Lucide name="PanelLeftClose" size={16} class="a-ico-close" /><Lucide name="PanelLeftOpen" size={16} class="a-ico-open" /></button>
            <nav class="a-top__crumbs" aria-label="Breadcrumb">
              <a href="/admin">Dashboard</a>
              {crumbs.map((c) => <Fragment> / {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</Fragment>)}
            </nav>
          </div>
          <div class="a-top__user">
            <span>{user.name}</span>
            <span class="a-role">{user.role}</span>
            <form method="post" action="/admin/logout"><button class="a-btn a-btn--ghost a-btn--sm" type="submit"><Lucide name="LogOut" size={15} /> Log out</button></form>
          </div>
        </header>
        {lockdown.on && (
          <div class="a-banner a-banner--danger" role="status"><Lucide name="Lock" size={16} /> <span><strong>Lockdown is active.</strong> {lockdown.freeze ? 'The CMS is read-only. ' : 'Only admins can sign in. '}Public comments and contact messages are paused.</span>{isAdmin && <a href="/admin/system/modes">Manage</a>}</div>
        )}
        {maintenance.on && (
          <div class="a-banner a-banner--warn" role="status"><Lucide name="Construction" size={16} /> <span><strong>Maintenance mode is on.</strong> Visitors see the maintenance page; signed-in staff can still browse the site.</span>{isAdmin && <a href="/admin/system/modes">Manage</a>}</div>
        )}
        <main class="a-content" id="main">
          <slot />
        </main>
      </div>
    </div>
    <script>
      import '../scripts/password-toggle';
      import '../scripts/idle-timeout';
      // Confirmation prompts for destructive buttons (no inline handlers, so CSP can forbid inline scripts).
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-confirm]');
        if (b && !confirm(b.dataset.confirm!)) e.preventDefault();
      });
      const side = document.querySelector<HTMLElement>('[data-side]');
      const root = document.documentElement;
      const toggleBtn = document.querySelector<HTMLButtonElement>('[data-collapse]');
      const phone = matchMedia('(max-width: 900px)');
      // One button: on phones it opens/closes the slide-in menu, on desktop it collapses the sidebar to icons
      // (remembered per browser; admin-boot.js applies it before paint).
      const syncCollapse = () => {
        const open = phone.matches ? !!side?.classList.contains('is-open') : !root.classList.contains('a-collapsed');
        toggleBtn?.setAttribute('aria-expanded', String(open));
        toggleBtn?.setAttribute('aria-label', phone.matches ? (open ? 'Close menu' : 'Open menu') : open ? 'Collapse sidebar' : 'Expand sidebar');
      };
      const setDrawer = (open: boolean) => {
        side?.classList.toggle('is-open', open);
        const scrim = document.querySelector<HTMLElement>('[data-scrim]');
        if (scrim) scrim.hidden = !open;
        document.body.classList.toggle('a-drawer-open', open);
        syncCollapse();
        if (open) side?.querySelector<HTMLElement>('[data-side-close]')?.focus();
      };
      const toggleCollapse = () => {
        if (phone.matches) return setDrawer(!side?.classList.contains('is-open'));
        const on = root.classList.toggle('a-collapsed');
        try { localStorage.setItem('shape-admin-collapsed', on ? '1' : '0'); } catch {}
        syncCollapse();
      };
      toggleBtn?.addEventListener('click', toggleCollapse);
      document.querySelector('[data-side-close]')?.addEventListener('click', () => { setDrawer(false); toggleBtn?.focus(); });
      // Tapping the dimmed backdrop or a menu link closes the phone menu.
      document.querySelector('[data-scrim]')?.addEventListener('click', () => setDrawer(false));
      side?.addEventListener('click', (e) => { if (phone.matches && (e.target as Element).closest('a')) setDrawer(false); });
      phone.addEventListener('change', () => setDrawer(false));
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key === 'Escape' && side?.classList.contains('is-open')) { setDrawer(false); toggleBtn?.focus(); return; }
        if (e.key === '[' && !e.metaKey && !e.ctrlKey && !e.altKey && !t.closest('input, textarea, select, [contenteditable="true"], .ProseMirror')) toggleCollapse();
      });
      syncCollapse();
    </script>
  </body>
</html>
