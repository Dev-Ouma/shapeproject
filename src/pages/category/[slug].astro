---
import Base from '../../layouts/Base.astro';
import PostArchive from '../../components/PostArchive.astro';
import { news, categories } from '../../data/news';

export function getStaticPaths() {
  return categories.map((c) => ({
    params: { slug: c.slug },
    props: { name: c.name, posts: news.filter((p) => p.categories.some((x) => x.slug === c.slug)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name}>
  <PostArchive heading="Category" label={name} posts={posts} />
</Base>
