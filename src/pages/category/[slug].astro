---
import Base from '../../layouts/Base.astro';
import PostArchive from '../../components/PostArchive.astro';
import { loadSite } from '../../lib/content';

const { posts: all, categories } = loadSite();
const cat = categories.find((c) => c.slug === Astro.params.slug);
if (!cat) return new Response(null, { status: 404 });
const posts = all.filter((p) => p.categories.some((x) => x.slug === cat.slug));
---

<Base title={cat.name}>
  <PostArchive heading="Category" label={cat.name} posts={posts} />
</Base>
