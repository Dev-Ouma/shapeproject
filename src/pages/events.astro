---
import { loadSite } from '../lib/content';
import Base from '../layouts/Base.astro';
import Lucide from '../components/Lucide.astro';
import { wpStatus as _wpStatus, statusLabel } from '../lib/status';
const { events, workPackages, currentMonth: CURRENT_PROJECT_MONTH, projectMonths: PROJECT_MONTHS, projectStart } = loadSite();
const wpStatus = (w: { start: number; end: number }) => _wpStatus(w, CURRENT_PROJECT_MONTH);

const months = Array.from({ length: PROJECT_MONTHS }, (_, i) => i + 1);
// Real calendar dates: Month 1 is the month of the project start date.
const start0 = new Date(projectStart + 'T00:00:00Z');
const monthDate = (m: number) => new Date(Date.UTC(start0.getUTCFullYear(), start0.getUTCMonth() + m - 1, 1));
const endOfMonth = (d: Date) => new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0));
const shortMonth = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' });
const longMonth = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const fmtDay = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const yearSpans = months.reduce<{ year: number; months: number }[]>((acc, m) => {
  const y = monthDate(m).getUTCFullYear();
  const last = acc[acc.length - 1];
  if (last?.year === y) last.months++;
  else acc.push({ year: y, months: 1 });
  return acc;
}, []);
// Fractional position (0–1) of a date on the timeline.
const frac = (d: Date) => {
  const mi = (d.getUTCFullYear() - start0.getUTCFullYear()) * 12 + d.getUTCMonth() - start0.getUTCMonth();
  const days = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0)).getUTCDate();
  return Math.min(Math.max((mi + (d.getUTCDate() - 1) / days) / PROJECT_MONTHS, 0), 1);
};
const pos = (iso: string) => `${frac(new Date((iso.length === 7 ? iso + '-15' : iso) + 'T00:00:00Z')) * 100}%`;
const today = new Date();
const todayFrac = frac(today);
const pct = Math.round((CURRENT_PROJECT_MONTH / PROJECT_MONTHS) * 100);
const col = (m: number) => `${((m - 1) / PROJECT_MONTHS) * 100}%`;
const width = (s: number, e: number) => `${((e - s + 1) / PROJECT_MONTHS) * 100}%`;
const nextMilestone = workPackages
  .flatMap((w) => w.deliverables.map((d) => ({ ...d, due: w.end, wp: w.wp })))
  .filter((d) => d.due >= CURRENT_PROJECT_MONTH)
  .sort((a, b) => a.due - b.due)[0];

const fmt = (iso: string) =>
  iso.length === 7
    ? new Date(iso + '-01T00:00:00Z').toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' })
    : new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (iso: string) => (iso.length === 7 ? '—' : String(new Date(iso + 'T00:00:00Z').getUTCDate()));
const mon = (iso: string) => new Date((iso.length === 7 ? iso + '-01' : iso) + 'T00:00:00Z').toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' });
const yr = (iso: string) => iso.slice(0, 4);
const typeIcon = { Meeting: 'Users', Launch: 'Rocket', Hackathon: 'Code', Training: 'GraduationCap', Pilot: 'FlaskConical', Conference: 'Mic', Workshop: 'Presentation' } as const;
---

<Base title="Events" description="SHAPE events, milestones and the 36-month project timeline.">
  <section class="section wp-section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">Events &amp; timeline</span>
        <h1 class="h-xl">Events</h1>
        <p>Where SHAPE meets, trains and builds — and how the 36-month programme unfolds.</p>
      </header>

      <div class="ev-stats">
        <div class="ev-ring" style={`--p:${pct}`}>
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="52" class="ev-ring__fill" /></svg>
          <div><strong>{pct}%</strong><span>elapsed</span></div>
        </div>
        <div class="ev-stat"><Lucide name="CalendarDays" size={22} /><strong>Month {CURRENT_PROJECT_MONTH}</strong><span>of {PROJECT_MONTHS}</span></div>
        <div class="ev-stat"><Lucide name="Flag" size={22} /><strong>{events.filter((e) => !e.planned).length} held</strong><span>{events.filter((e) => e.planned).length} planned</span></div>
        {nextMilestone && (
          <div class="ev-stat ev-stat--wide"><Lucide name="Target" size={22} /><strong>Next: {nextMilestone.code}</strong><span>{nextMilestone.desc} · due M{nextMilestone.due}</span></div>
        )}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <header class="section-head">
        <h2>Project Timeline</h2>
        <p>Work Packages across the 36 months, with deliverable deadlines and events. Hover a bar or marker for details.</p>
      </header>

      <div class="gantt-scroll" tabindex="0" aria-label="Project Gantt chart with real dates, scrollable">
        <div class="gx" style={`--months:${PROJECT_MONTHS}`}>
          <div class="gx__corner gx__corner--top">Work package</div>
          <div class="gx__years" style={`grid-template-columns:${yearSpans.map((y) => `${y.months}fr`).join(' ')}`}>
            {yearSpans.map((y) => <span>{y.year}</span>)}
          </div>
          <div class="gx__corner">Lead · dates</div>
          <div class="gx__quarters" style={`grid-template-columns:repeat(${PROJECT_MONTHS}, 1fr)`}>
            {months.map((m) => {
              const d = monthDate(m);
              return <span class:list={{ 'is-q': d.getUTCMonth() % 3 === 0, 'is-now': m === CURRENT_PROJECT_MONTH }} title={`${longMonth(d)} · Month ${m}`}>{shortMonth(d)}</span>;
            })}
          </div>

          {workPackages.map((w, wi) => {
            const s = wpStatus(w);
            const down = wi < 2 ? ' gx__tip--down' : '';
            const done = Math.min(Math.max(CURRENT_PROJECT_MONTH - w.start + 1, 0), w.end - w.start + 1);
            const startD = monthDate(w.start);
            const endD = monthDate(w.end);
            const due = endOfMonth(endD);
            return (
              <Fragment>
                <div class="gx__label" style={`--wp:${w.color};--wp-tint:${w.tint}`}>
                  <span class="gx__wp">WP{w.wp}</span>
                  <div>
                    <strong>{w.title}</strong>
                    <span>{w.lead}</span>
                    <span class="gx__dates">{shortMonth(startD)} {startD.getUTCFullYear()} – {shortMonth(endD)} {endD.getUTCFullYear()}</span>
                  </div>
                </div>
                <div class="gx__track">
                  <div class="gx__bar" style={`--wp:${w.color};--wp-tint:${w.tint};left:${col(w.start)};width:${width(w.start, w.end)};--done:${(done / (w.end - w.start + 1)) * 100}%`} tabindex="0" aria-label={`WP${w.wp}: ${longMonth(startD)} to ${longMonth(endD)}`}>
                    <span class={`gx__tip${down}`}>
                      <b>WP{w.wp} · {w.title}</b>
                      <em class={`status status--${s}`}>{statusLabel[s]}</em>
                      <span><Lucide name="CalendarDays" size={13} /> {fmtDay(startD)} – {fmtDay(due)}</span>
                      <span><Lucide name="Clock" size={13} /> {w.end - w.start + 1} months (M{w.start}–M{w.end}) · {Math.round((done / (w.end - w.start + 1)) * 100)}% elapsed</span>
                      <span><Lucide name="House" size={13} /> Lead: {w.lead}</span>
                    </span>
                  </div>
                  <span class="gx__milestone" style={`--wp:${w.color};left:calc(${col(w.end)} + ${100 / PROJECT_MONTHS}%)`} tabindex="0" aria-label={`Deliverables due ${fmtDay(due)}`}>
                    <span class={`gx__tip gx__tip--right${down}`}>
                      <b>Deliverables due {fmtDay(due)}</b>
                      {w.deliverables.map((d) => <span><strong>{d.code}</strong> {d.desc}</span>)}
                    </span>
                  </span>
                </div>
              </Fragment>
            );
          })}

          <div class="gx__label gx__label--events"><span class="gx__wp gx__wp--ev"><Lucide name="Flag" size={14} /></span><div><strong>Events</strong><span>Held and planned</span></div></div>
          <div class="gx__track gx__track--events">
            {events.map((e) => (
              <span class:list={['gx__event', { 'is-planned': e.planned }]} style={`left:${pos(e.start)}`} tabindex="0" aria-label={`${e.title}, ${fmt(e.start)}`}>
                <Lucide name={typeIcon[e.type as keyof typeof typeIcon] ?? 'Calendar'} size={13} />
                <span class="gx__tip">
                  <b>{e.title}</b>
                  <span><Lucide name="CalendarDays" size={13} /> {e.planned ? `${fmt(e.start)}${e.end ? ` – ${fmt(e.end)}` : ''} (dates to be confirmed)` : `${fmt(e.start)}${e.end ? ` – ${fmt(e.end)}` : ''}`}</span>
                  <span><Lucide name="MapPin" size={13} /> {e.location}</span>
                  <em class={`status status--${e.planned ? 'upcoming' : 'done'}`}>{e.planned ? 'Planned' : 'Held'} · {e.type}</em>
                </span>
              </span>
            ))}
          </div>

          <div class="gx__now" style={`left:calc(var(--label-w) + (100% - var(--label-w) - var(--pad-r)) * ${todayFrac})`}>
            <span>Today · {fmtDay(today)}</span>
          </div>
        </div>
      </div>
      <ul class="gantt-legend">
        <li><i class="lg-bar"></i> Work package (solid = elapsed)</li>
        <li><i class="lg-diamond"></i> Deliverables due (end of month)</li>
        <li><i class="lg-event"></i> Event held</li>
        <li><i class="lg-event lg-event--planned"></i> Event planned</li>
        <li><i class="lg-now"></i> Today</li>
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="events-list">
    <div class="container">
      <header class="section-head">
        <h2>Events</h2>
        <p>Meetings, launches, trainings and hackathons across the consortium.</p>
      </header>
      <div class="dl__chips ev-tabs" role="group" aria-label="Filter events" data-ev-filter>
        <button class="chip is-active" type="button" data-f="">All</button>
        <button class="chip" type="button" data-f="past">Held</button>
        <button class="chip" type="button" data-f="planned">Planned</button>
      </div>
      <div class="ev-list">
        {events.map((e) => (
          <article class:list={['ev-card', { 'is-planned': e.planned }]} data-state={e.planned ? 'planned' : 'past'}>
            <div class="ev-card__date">
              <strong>{day(e.start)}</strong><span>{mon(e.start)}</span><em>{yr(e.start)}</em>
            </div>
            {e.image ? <img class="ev-card__img" src={e.image} alt="" loading="lazy" /> : <div class="ev-card__img ev-card__img--ph"><Lucide name={typeIcon[e.type]} size={40} /></div>}
            <div class="ev-card__body">
              <div class="ev-card__tags">
                <span class={`ev-type ev-type--${e.type.toLowerCase()}`}><Lucide name={typeIcon[e.type]} size={13} /> {e.type}</span>
                <span class={`status status--${e.planned ? 'upcoming' : 'done'}`}>{e.planned ? 'Planned · dates TBC' : 'Held'}</span>
              </div>
              <h3>{e.title}</h3>
              <p class="ev-card__meta"><Lucide name="CalendarDays" size={14} /> {fmt(e.start)}{e.end ? ` – ${fmt(e.end)}` : ''} <Lucide name="MapPin" size={14} /> {e.location}</p>
              <p>{e.text}</p>
              {e.link && <a class="news-card__more" href={e.link}>Read the story <Lucide name="ArrowRight" size={16} /></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-ev-filter] .chip')];
    const cards = [...document.querySelectorAll<HTMLElement>('.ev-card')];
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        chips.forEach((x) => x.classList.toggle('is-active', x === c));
        cards.forEach((card) => (card.hidden = !!c.dataset.f && card.dataset.state !== c.dataset.f));
      }),
    );
  </script>
</Base>
