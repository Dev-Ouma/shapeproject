---
import Base from '../../layouts/Base.astro';
import PostArchive from '../../components/PostArchive.astro';
import { news } from '../../data/news';

export function getStaticPaths() {
  const tags = new Map<string, string>();
  news.forEach((p) => p.tags.forEach((t) => tags.set(t.slug, t.name)));
  return [...tags].map(([slug, name]) => ({
    params: { slug },
    props: { name, posts: news.filter((p) => p.tags.some((t) => t.slug === slug)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name}>
  <PostArchive heading="Tag" label={name} posts={posts} />
</Base>
