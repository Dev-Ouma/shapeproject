---
import Base from '../../layouts/Base.astro';
import PostArchive from '../../components/PostArchive.astro';
import { loadSite } from '../../lib/content';

const { posts: all } = loadSite();
const posts = all.filter((p) => p.tags.some((t) => t.slug === Astro.params.slug));
if (!posts.length) return new Response(null, { status: 404 });
const name = posts[0].tags.find((t) => t.slug === Astro.params.slug)!.name;
---

<Base title={name} noindex description={`SHAPE Project articles tagged ${name}.`}>
  <PostArchive heading="Tag" label={name} posts={posts} />
</Base>
