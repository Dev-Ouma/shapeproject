---
import Base from '../../layouts/Base.astro';
import { loadSite, listEntries, toPost } from '../../lib/content';
import { approvedComments } from '../../lib/engagement';
import { formatDate } from '../../lib/format';
import { articleLd, metaDescription } from '../../lib/seo';

const site = loadSite();
let post = site.posts.find((p) => p.slug === Astro.params.slug);
// Logged-in editors can preview drafts and scheduled posts.
const preview = !post && Astro.locals.user ? listEntries('posts', { includeDrafts: true }).find((e) => e.slug === Astro.params.slug) : undefined;
if (preview) post = toPost(preview, new Map(site.categories.map((c) => [c.name, c.slug])));
if (!post) return new Response(null, { status: 404 });
const comments = approvedComments(post.slug);
const commentState = Astro.url.searchParams.get('comment');
const siteUrl = Astro.site ?? new URL('https://shapeproject.ouk.ac.ke');
const description = metaDescription(post.excerpt || post.title);
const ld = articleLd(siteUrl, { title: post.title, description, url: new URL(Astro.url.pathname, siteUrl).href, image: new URL(post.image || '/images/slider1.png', siteUrl).href, published: post.date, modified: post.modified });
---

<Base title={post.title} description={description} image={post.image} jsonLd={preview ? [] : [ld]} noindex={!!preview} type="article" published={post.date} modified={post.modified} readingMinutes={post.readingMinutes}>
  {preview && <div class="preview-bar">Preview — this post is {preview.status === 'draft' ? 'a draft' : 'scheduled'} and not visible to the public.</div>}
  <article class="site-main single-post">
    <header class="page-header">
      <h1 class="entry-title">{post.title}</h1>
    </header>
    <div class="page-content">
      <Fragment set:html={post.html} />
      {post.tags.length > 0 && (
        <div class="post-tags">
          <span class="tag-links">
            Tagged{' '}
            {post.tags.map((t, i) => (
              <Fragment><a href={`/tag/${t.slug}/`} rel="tag">{t.name}</a>{i < post.tags.length - 1 ? ', ' : ''}</Fragment>
            ))}
          </span>
        </div>
      )}
    </div>

    {comments.length > 0 && (
      <section class="comments-list" aria-label="Comments">
        <h2 class="comment-reply-title">{comments.length} {comments.length === 1 ? 'Reply' : 'Replies'}</h2>
        <ol>
          {comments.map((c) => (
            <li id={`comment-${c.id}`}>
              <div class="comments-list__avatar" aria-hidden="true">{c.author.slice(0, 1).toUpperCase()}</div>
              <div>
                <strong>{c.url ? <a href={c.url} rel="nofollow ugc noopener" target="_blank">{c.author}</a> : c.author}</strong>
                <time datetime={c.created_at}>{formatDate(new Date(c.created_at.replace(' ', 'T') + 'Z'))}</time>
                <p>{c.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {post.commentsOpen && (
      <section id="comments" class="comments-area">
        <div id="respond" class="comment-respond">
          <h2 id="reply-title" class="comment-reply-title">Leave a Reply</h2>
          {commentState === 'pending' && <p class="form-flash form-flash--ok" role="status">Thank you — your comment is awaiting moderation.</p>}
          {commentState === 'error' && <p class="form-flash form-flash--err" role="alert">Your comment could not be posted. Please fill in all required fields and try again.</p>}
          <form action="/api/comments" method="post" id="commentform" class="comment-form">
            <input type="hidden" name="post" value={post.slug} />
            <p class="hp" aria-hidden="true"><label>Leave empty<input name="website_hp" tabindex="-1" autocomplete="off" /></label></p>
            <p class="comment-notes">
              <span id="email-notes">Your email address will not be published.</span>
              <span class="required-field-message"> Required fields are marked <span class="required">*</span></span>
            </p>
            <p class="comment-form-comment">
              <label for="comment">Comment <span class="required">*</span></label>
              <textarea id="comment" name="comment" cols="45" rows="8" maxlength="65525" required></textarea>
            </p>
            <p class="comment-form-author">
              <label for="author">Name <span class="required">*</span></label>
              <input id="author" name="author" type="text" size="30" maxlength="245" autocomplete="name" required />
            </p>
            <p class="comment-form-email">
              <label for="email">Email <span class="required">*</span></label>
              <input id="email" name="email" type="email" size="30" maxlength="100" aria-describedby="email-notes" autocomplete="email" required />
            </p>
            <p class="comment-form-url">
              <label for="url">Website</label>
              <input id="url" name="url" type="url" size="30" maxlength="200" autocomplete="url" />
            </p>
            <p class="comment-form-cookies-consent">
              <input id="wp-comment-cookies-consent" name="wp-comment-cookies-consent" type="checkbox" value="yes" />
              <label for="wp-comment-cookies-consent">Save my name, email, and website in this browser for the next time I comment.</label>
            </p>
            <p class="form-submit">
              <input name="submit" type="submit" id="submit" class="submit" value="Post Comment" />
            </p>
          </form>
        </div>
      </section>
    )}
  </article>

  <script>
    // Mirrors WordPress's "remember me" cookie behaviour using localStorage.
    const KEY = 'shape-comment-author';
    const form = document.querySelector<HTMLFormElement>('#commentform');
    if (form) {
      const fields = ['author', 'email', 'url'] as const;
      const consent = form.querySelector<HTMLInputElement>('#wp-comment-cookies-consent')!;
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) ?? 'null');
        if (saved) {
          fields.forEach((f) => (form.querySelector<HTMLInputElement>(`#${f}`)!.value = saved[f] ?? ''));
          consent.checked = true;
        }
      } catch {}
      form.addEventListener('submit', () => {
        try {
          if (consent.checked) {
            localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(fields.map((f) => [f, form.querySelector<HTMLInputElement>(`#${f}`)!.value]))));
          } else {
            localStorage.removeItem(KEY);
          }
        } catch {}
      });
    }
  </script>
</Base>
