---
import { loadSite } from '../lib/content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
const { contact, socials } = loadSite();
const sent = Astro.url.searchParams.get('sent');
const tel = contact.phone.replace(/[^+\d]/g, '');
---

<Base title="Contact" description="Contact the SHAPE Project team at the Open University of Kenya: email, phone and the online contact form.">
  <PageHero title="Contact" lead="Get in touch with the SHAPE project team." />
  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <a class="card contact__item" href={`mailto:${contact.email}`}><Icon name="mail" size={22} /><span><strong>Email</strong>{contact.email}</span></a>
        <a class="card contact__item" href={`tel:${tel}`}><Icon name="phone" size={22} /><span><strong>Phone</strong>{contact.phone}</span></a>
        <ul class="social social--lg">
          {socials.map((s) => <li><a href={s.href} aria-label={s.name} target="_blank" rel="noopener"><Icon name={s.icon} size={20} /></a></li>)}
        </ul>
      </div>
      <form class="card contact__form" method="post" action="/api/contact">
        {sent === '1' && <p class="form-flash form-flash--ok" role="status">Thank you — your message has been sent. We will get back to you soon.</p>}
        {sent === '0' && <p class="form-flash form-flash--err" role="alert">Please fill in all fields with a valid email address.</p>}
        <p class="hp" aria-hidden="true"><label>Leave empty<input name="website_hp" tabindex="-1" autocomplete="off" /></label></p>
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Subject<input name="subject" required /></label>
        <label>Message<textarea name="message" rows="6" required></textarea></label>
        <button class="btn" type="submit">Send message</button>
        <p class="form-note">Or email us directly at <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
      </form>
    </div>
  </section>
</Base>
