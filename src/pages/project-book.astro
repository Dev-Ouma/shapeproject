---
import { loadSite } from '../lib/content';
import Base from '../layouts/Base.astro';
import '../styles/book.css';
import Lucide from '../components/Lucide.astro';
import { bookPdfUrl } from '../lib/book';
import { wpStatus, statusLabel } from '../lib/status';
const site = loadSite();
const { aboutParagraphs, goal, mission, thematicAreas, targetGroups, impacts, workPackages, partners, contact, disclaimer, projectMonths: PROJECT_MONTHS, projectStart, currentMonth, coordinator, associated: associatedPartners, events } = site;

const PDF = bookPdfUrl();
const start0 = new Date(projectStart + 'T00:00:00Z');
const monthDate = (m: number) => new Date(Date.UTC(start0.getUTCFullYear(), start0.getUTCMonth() + m - 1, 1));
const endOfMonth = (m: number) => new Date(Date.UTC(start0.getUTCFullYear(), start0.getUTCMonth() + m, 0));
const my = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const dmy = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const fmtIso = (iso: string) => (iso.length === 7 ? my(new Date(iso + '-01T00:00:00Z')) : dmy(new Date(iso + 'T00:00:00Z')));
const endD = endOfMonth(PROJECT_MONTHS);
const period = `${my(monthDate(1))} – ${my(endD)}`;
const edition = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const deliverables = workPackages.flatMap((w) => w.deliverables.map((d) => ({ ...d, wp: w.wp, color: w.color, due: endOfMonth(w.end), status: wpStatus(w, currentMonth) })));
const counts = { done: workPackages.filter((w) => wpStatus(w, currentMonth) === 'done').length, progress: workPackages.filter((w) => wpStatus(w, currentMonth) === 'progress').length, upcoming: workPackages.filter((w) => wpStatus(w, currentMonth) === 'upcoming').length };
const elapsed = Math.round((currentMonth / PROJECT_MONTHS) * 100);
const countries = [...new Set(partners.map((p) => p.country))];
const eastAfrica = countries.filter((c) => ['Kenya', 'Somalia', 'Uganda'].includes(c));
const col = (m: number) => `${((m - 1) / PROJECT_MONTHS) * 100}%`;
const width = (s: number, e: number) => `${((e - s + 1) / PROJECT_MONTHS) * 100}%`;
const yearSpans = Array.from({ length: PROJECT_MONTHS }, (_, i) => monthDate(i + 1).getUTCFullYear()).reduce<{ year: number; n: number }[]>((a, y) => { const l = a[a.length - 1]; if (l?.year === y) l.n++; else a.push({ year: y, n: 1 }); return a; }, []);
const held = events.filter((e) => !e.planned);
const planned = events.filter((e) => e.planned);
const toc = [
  { id: 'summary', title: 'Executive Summary' },
  { id: 'context', title: 'Context and Rationale' },
  { id: 'objectives', title: 'Objectives and Approach' },
  { id: 'impact', title: 'Expected Outcomes and Impact' },
  { id: 'governance', title: 'Consortium and Governance' },
  { id: 'workplan', title: 'Work Plan' },
  { id: 'timeline', title: 'Timeline and Milestones' },
  { id: 'register', title: 'Deliverables Register' },
  { id: 'progress', title: 'Progress to Date' },
  { id: 'contact', title: 'Contact' },
];
const isoDate = (iso: string) => new Date((iso.length === 7 ? iso + '-01' : iso) + 'T00:00:00Z');
const milestones = [
  ...events.map((e) => ({ at: isoDate(e.start), date: `${fmtIso(e.start)}${e.end ? ` – ${fmtIso(e.end)}` : ''}`, label: `${e.title} · ${e.location}`, status: e.planned ? 'upcoming' : 'done', statusText: e.planned ? 'Planned' : 'Held' })),
  ...workPackages.map((w) => ({ at: endOfMonth(w.end), date: dmy(endOfMonth(w.end)), label: `WP${w.wp} deliverables due (${w.deliverables.map((d) => d.code).join(', ')})`, status: wpStatus(w, currentMonth), statusText: statusLabel[wpStatus(w, currentMonth)] })),
].sort((a, b) => a.at.getTime() - b.at.getTime());
const pageOf = (id: string) => toc.findIndex((t) => t.id === id) + 3;
const Foot = 'shapeproject.ouk.ac.ke';
---

<Base title="Executive Brief" description="SHAPE Executive Brief — objectives, consortium, work plan, timeline and deliverables of the Smart City Higher Education Advancement Program in East Africa. Read online or download as PDF.">
  <div class="book-toolbar" data-toolbar>
    <div class="book-toolbar__inner">
      <button class="book-btn book-btn--ghost" type="button" data-toc-toggle aria-expanded="false" aria-controls="book-toc"><Lucide name="List" size={16} /> Contents</button>
      <div class="book-toolbar__title"><strong>SHAPE Executive Brief</strong><span data-page-indicator>Cover</span></div>
      <div class="book-toolbar__actions">
        <button class="book-btn book-btn--ghost" type="button" data-copy title="Copy link"><Lucide name="Link" size={16} /><span>Copy link</span></button>
        <button class="book-btn book-btn--ghost" type="button" data-print title="Print"><Lucide name="Printer" size={16} /><span>Print</span></button>
        <a class="book-btn" href={PDF} download="SHAPE-Executive-Brief.pdf"><Lucide name="Download" size={16} /><span>Download PDF</span></a>
      </div>
    </div>
    <div class="book-progress"><span data-progress></span></div>
  </div>

  <nav id="book-toc" class="book-toc" aria-label="Executive brief contents" data-toc>
    <strong>Contents</strong>
    <ol>
      <li><a href="#cover">Cover</a></li>
      {toc.map((t) => <li><a href={`#${t.id}`}>{t.title}</a></li>)}
    </ol>
  </nav>

  <div class="book exec" data-no-reveal>
    <!-- Cover -->
    <section class="sheet x-cover" id="cover" data-title="Cover">
      <div class="x-cover__band">
        <img src="/images/White-SHAPE-final-Logo-1-1024x431.png" alt="SHAPE" class="x-cover__logo" />
        <span class="x-cover__tag">Executive Brief</span>
      </div>
      <div class="x-cover__body">
        <p class="x-kicker">Erasmus+ Capacity Building in Higher Education · Strand 2</p>
        <h1>Smart City Higher Education Advancement Program in East Africa</h1>
        <p class="x-cover__lede">Strengthening universities in Kenya, Somalia and Uganda to educate the professionals who will plan, build and govern sustainable, inclusive smart cities.</p>
        <dl class="x-cover__meta">
          <div><dt>Programme period</dt><dd>{period}</dd></div>
          <div><dt>Coordinator</dt><dd>{coordinator?.institution ?? 'Moi University'}</dd></div>
          <div><dt>Consortium</dt><dd>{partners.length} universities · {countries.length} countries</dd></div>
          <div><dt>Edition</dt><dd>{edition}</dd></div>
        </dl>
      </div>
      <figure class="x-cover__photo"><img src="/images/slider-ouk-city.jpg" alt="" /></figure>
      <div class="x-cover__foot">
        <img src="/images/EU-scaled.png" alt="Co-funded by the Erasmus+ Programme of the European Union" />
        <span>Reference: ERASMUS-EDU-2025-CBHE-STRAND-2</span>
        <span class="x-cover__host">Hosted by <img src="/images/ouk-logo.png" alt="Open University of Kenya" /></span>
      </div>
    </section>

    <!-- Contents -->
    <section class="sheet" id="contents" data-title="Contents">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>Contents</span></header>
      <h2 class="x-title">Contents</h2>
      <ol class="x-toc">
        {toc.map((t, i) => (
          <li><a href={`#${t.id}`}><span class="x-toc__n">{i + 1}</span><span class="x-toc__t">{t.title}</span><span class="x-toc__dots"></span><span class="x-toc__p">{pageOf(t.id)}</span></a></li>
        ))}
      </ol>
      <div class="x-note">
        <strong>About this document</strong>
        <p>This brief summarises the SHAPE programme for decision-makers, partners and funders. It is generated from the live project website, so figures, statuses and dates reflect the position on {edition}.</p>
      </div>
      <footer class="x-foot"><span>{Foot}</span><span>2</span></footer>
    </section>

    <!-- 1 Executive summary -->
    <section class="sheet" id="summary" data-title="Executive Summary">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>1 · Executive Summary</span></header>
      <span class="x-chapter">Section 1</span>
      <h2 class="x-title">Executive Summary</h2>
      <p class="x-lead">SHAPE is a {PROJECT_MONTHS}-month Erasmus+ capacity-building programme in which {partners.length} European and East African universities modernise higher education for smart, sustainable and inclusive cities.</p>
      <div class="x-two">
        <div>
          <h3 class="x-h3">Key messages</h3>
          <ul class="x-bullets">
            <li><b>The gap is skills, not ambition.</b> African cities are urbanising rapidly, yet most lack the planners, engineers and data specialists to make smart city strategies work.</li>
            <li><b>Universities are the lever.</b> SHAPE builds Master's-level curricula, micro-credentials and trained academic staff in {eastAfrica.join(', ')}.</li>
            <li><b>Learning by doing.</b> Open Innovation Labs and hackathons connect students with real city, industry and government challenges.</li>
            <li><b>Built to last.</b> An EU–East Africa Smart Cities Alliance sustains collaboration beyond {endD.getUTCFullYear()}.</li>
          </ul>
        </div>
        <div>
          <h3 class="x-h3">Programme at a glance</h3>
          <table class="x-table x-table--kv">
            <tbody>
              <tr><th>Funding</th><td>Erasmus+ CBHE, Strand 2 (EACEA)</td></tr>
              <tr><th>Period</th><td>{period} ({PROJECT_MONTHS} months)</td></tr>
              <tr><th>Coordinator</th><td>{coordinator ? `${coordinator.institution} — ${coordinator.name}` : 'Moi University'}</td></tr>
              <tr><th>Partners</th><td>{partners.length} universities in {countries.join(', ')}</td></tr>
              <tr><th>Associated partners</th><td>{associatedPartners.length}</td></tr>
              <tr><th>Thematic domains</th><td>{thematicAreas.length}</td></tr>
              <tr><th>Work packages</th><td>{workPackages.length}</td></tr>
              <tr><th>Deliverables</th><td>{deliverables.length}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <h3 class="x-h3">Status snapshot · {edition}</h3>
      <div class="x-kpis">
        <div><strong>M{currentMonth}</strong><span>of {PROJECT_MONTHS} months</span></div>
        <div><strong>{elapsed}%</strong><span>of programme time elapsed</span></div>
        <div><strong>{counts.done}</strong><span>work package{counts.done === 1 ? '' : 's'} completed</span></div>
        <div><strong>{counts.progress}</strong><span>in progress</span></div>
        <div><strong>{counts.upcoming}</strong><span>upcoming</span></div>
        <div><strong>{held.length}</strong><span>consortium events held</span></div>
      </div>
      <div class="x-progress" aria-label={`${elapsed}% of programme time elapsed`}><span style={`width:${elapsed}%`}></span></div>
      <footer class="x-foot"><span>{Foot}</span><span>3</span></footer>
    </section>

    <!-- 2 Context -->
    <section class="sheet" id="context" data-title="Context and Rationale">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>2 · Context and Rationale</span></header>
      <span class="x-chapter">Section 2</span>
      <h2 class="x-title">Context and Rationale</h2>
      <div class="x-two x-two--wide">
        <div class="x-prose">
          {aboutParagraphs.slice(0, 2).map((p) => <p>{p}</p>)}
        </div>
        <aside class="x-aside">
          <div class="x-stat"><strong>93%</strong><p>of local governments in Africa report skills shortages as a major barrier to smart city development.</p></div>
          <div class="x-stat"><strong>29%</strong><p>of African cities currently have a smart city strategy in place.</p></div>
          <p class="x-source">Source: UN-Habitat, cited at the SHAPE launch (June 2026).</p>
        </aside>
      </div>
      <figure class="x-figure"><img src="/images/slider2.png" alt="" /><figcaption>Figure 1. Rapid urbanisation is reshaping East African cities and the skills they require.</figcaption></figure>
      <footer class="x-foot"><span>{Foot}</span><span>4</span></footer>
    </section>

    <!-- 3 Objectives -->
    <section class="sheet" id="objectives" data-title="Objectives and Approach">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>3 · Objectives and Approach</span></header>
      <span class="x-chapter">Section 3</span>
      <h2 class="x-title">Objectives and Approach</h2>
      <div class="x-two">
        <div class="x-box"><h3 class="x-h3">Goal</h3><p>{goal}</p></div>
        <div class="x-box"><h3 class="x-h3">Mission</h3><p>{mission}</p></div>
      </div>
      <h3 class="x-h3">Four strategic pillars</h3>
      <table class="x-table">
        <thead><tr><th>Pillar</th><th>What SHAPE delivers</th></tr></thead>
        <tbody>
          <tr><th>Curriculum</th><td>New and updated Master's-level courses, open online courses and accredited micro-credentials.</td></tr>
          <tr><th>Academic capacity</th><td>Train-the-trainer programmes equipping staff with modern teaching methods and smart city expertise.</td></tr>
          <tr><th>Innovation</th><td>Open Innovation Labs and three hackathons linking universities with industry and government.</td></tr>
          <tr><th>Sustainability</th><td>An EU–East Africa Smart Cities Alliance, dissemination and a sustainability strategy.</td></tr>
        </tbody>
      </table>
      <h3 class="x-h3">Thematic domains ({thematicAreas.length})</h3>
      <ol class="x-cols">{thematicAreas.map((t) => <li>{t.title}</li>)}</ol>
      <footer class="x-foot"><span>{Foot}</span><span>5</span></footer>
    </section>

    <!-- 4 Impact -->
    <section class="sheet" id="impact" data-title="Expected Outcomes and Impact">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>4 · Expected Outcomes and Impact</span></header>
      <span class="x-chapter">Section 4</span>
      <h2 class="x-title">Expected Outcomes and Impact</h2>
      <table class="x-table x-table--num">
        <thead><tr><th>#</th><th>Outcome</th><th>Description</th></tr></thead>
        <tbody>{impacts.map((m, i) => <tr><td>{String(i + 1).padStart(2, '0')}</td><th>{m.title}</th><td>{m.text}</td></tr>)}</tbody>
      </table>
      <h3 class="x-h3">Target groups</h3>
      <ul class="x-tags">{targetGroups.map((t) => <li>{t.title}</li>)}</ul>
      <footer class="x-foot"><span>{Foot}</span><span>6</span></footer>
    </section>

    <!-- 5 Governance -->
    <section class="sheet" id="governance" data-title="Consortium and Governance">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>5 · Consortium and Governance</span></header>
      <span class="x-chapter">Section 5</span>
      <h2 class="x-title">Consortium and Governance</h2>
      <p class="x-lead">{coordinator?.institution ?? 'Moi University'} coordinates the programme{coordinator ? `, with ${coordinator.name} as ${coordinator.role}` : ''}. Each work package is led by a partner institution.</p>
      <table class="x-table x-table--partners">
        <thead><tr><th>Institution</th><th>Country</th><th>Role</th><th>Leads</th></tr></thead>
        <tbody>
          {partners.map((p) => {
            const leads = workPackages.filter((w) => w.lead === p.name);
            return (
              <tr>
                <th><img src={p.logo} alt="" />{p.name}</th>
                <td><img class="x-flag" src={`https://flagcdn.com/w40/${p.flag}.png`} alt="" />{p.country}</td>
                <td>{p.role}</td>
                <td>{leads.length ? leads.map((w) => <span class="x-wp" style={`--wp:${w.color}`}>WP{w.wp}</span>) : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <h3 class="x-h3">Associated partners</h3>
      <table class="x-table">
        <tbody>{associatedPartners.map((a) => <tr><th>{a.name}</th><td><img class="x-flag" src={`https://flagcdn.com/w40/${a.flag}.png`} alt="" />{a.country}</td><td>Case studies, curriculum input, regional outreach</td></tr>)}</tbody>
      </table>
      <footer class="x-foot"><span>{Foot}</span><span>7</span></footer>
    </section>

    <!-- 6 Work plan -->
    <section class="sheet" id="workplan" data-title="Work Plan">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>6 · Work Plan</span></header>
      <span class="x-chapter">Section 6</span>
      <h2 class="x-title">Work Plan</h2>
      <p class="x-lead">Five coordinated work packages carry SHAPE from research through to a lasting EU–East Africa alliance.</p>
      <table class="x-table x-table--wp">
        <thead><tr><th>WP</th><th>Title and scope</th><th>Lead</th><th>Period</th><th>Status</th></tr></thead>
        <tbody>
          {workPackages.map((w) => {
            const st = wpStatus(w, currentMonth);
            return (
              <tr style={`--wp:${w.color}`}>
                <td><span class="x-wp">WP{w.wp}</span></td>
                <td><strong>{w.title}</strong><p>{w.summary}</p><small>{w.deliverables.length} deliverables</small></td>
                <td>{w.lead}</td>
                <td class="x-nowrap">{my(monthDate(w.start))} –<br />{my(endOfMonth(w.end))}<br /><small>M{w.start}–M{w.end}</small></td>
                <td><span class={`status status--${st}`}>{statusLabel[st]}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <footer class="x-foot"><span>{Foot}</span><span>8</span></footer>
    </section>

    <!-- 7 Timeline -->
    <section class="sheet" id="timeline" data-title="Timeline and Milestones">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>7 · Timeline and Milestones</span></header>
      <span class="x-chapter">Section 7</span>
      <h2 class="x-title">Timeline and Milestones</h2>
      <div class="x-gantt">
        <div class="x-gantt__row x-gantt__row--head"><span></span><div class="x-gantt__years" style={`grid-template-columns:${yearSpans.map((y) => `${y.n}fr`).join(' ')}`}>{yearSpans.map((y) => <span>{y.year}</span>)}</div></div>
        {workPackages.map((w) => (
          <div class="x-gantt__row">
            <span class="x-gantt__label" style={`color:${w.color}`}>WP{w.wp}<small>{my(monthDate(w.start))} – {my(endOfMonth(w.end))}</small></span>
            <div class="x-gantt__track"><span style={`left:${col(w.start)};width:${width(w.start, w.end)};background:${w.color}`}></span><i style={`left:calc(${col(w.end)} + ${100 / PROJECT_MONTHS}%);border-color:${w.color}`}></i></div>
          </div>
        ))}
        <div class="x-gantt__row"><span class="x-gantt__label">Today<small>{dmy(new Date())}</small></span><div class="x-gantt__track x-gantt__track--now"><b style={`left:${(currentMonth - 0.5) / PROJECT_MONTHS * 100}%`}></b></div></div>
      </div>
      <h3 class="x-h3">Key milestones</h3>
      <table class="x-table">
        <thead><tr><th>Date</th><th>Milestone</th><th>Status</th></tr></thead>
        <tbody>
          {milestones.map((m) => <tr><td class="x-nowrap">{m.date}</td><td>{m.label}</td><td><span class={`status status--${m.status}`}>{m.statusText}</span></td></tr>)}
        </tbody>
      </table>
      <footer class="x-foot"><span>{Foot}</span><span>9</span></footer>
    </section>

    <!-- 8 Register -->
    <section class="sheet" id="register" data-title="Deliverables Register">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>8 · Deliverables Register</span></header>
      <span class="x-chapter">Section 8</span>
      <h2 class="x-title">Deliverables Register</h2>
      <table class="x-table x-table--reg">
        <thead><tr><th>Code</th><th>Deliverable</th><th>Due</th><th>Status</th></tr></thead>
        <tbody>
          {deliverables.map((d) => (
            <tr style={`--wp:${d.color}`}>
              <td><span class="x-code">{d.code}</span></td>
              <td>{d.desc}</td>
              <td class="x-nowrap">{my(d.due)}</td>
              <td>{d.file ? <span class="status status--done">Published</span> : d.status === 'done' ? <span class="status status--pending">Awaiting publication</span> : <span class={`status status--${d.status}`}>{statusLabel[d.status]}</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <footer class="x-foot"><span>{Foot}</span><span>10</span></footer>
    </section>

    <!-- 9 Progress -->
    <section class="sheet" id="progress" data-title="Progress to Date">
      <header class="x-head"><span>SHAPE Executive Brief</span><span>9 · Progress to Date</span></header>
      <span class="x-chapter">Section 9</span>
      <h2 class="x-title">Progress to Date</h2>
      <div class="x-events">
        {held.map((e) => (
          <article>
            {e.image && <img src={e.image} alt="" />}
            <div>
              <span class="x-date">{fmtIso(e.start)}{e.end ? ` – ${fmtIso(e.end)}` : ''} · {e.location}</span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          </article>
        ))}
      </div>
      <h3 class="x-h3">Next steps</h3>
      <table class="x-table">
        <tbody>{planned.map((e) => <tr><td class="x-nowrap">{fmtIso(e.start)}{e.end ? ` – ${fmtIso(e.end)}` : ''}</td><th>{e.title}</th><td>{e.text}</td></tr>)}</tbody>
      </table>
      <footer class="x-foot"><span>{Foot}</span><span>11</span></footer>
    </section>

    <!-- 10 Contact -->
    <section class="sheet x-back" id="contact" data-title="Contact">
      <div class="x-back__top">
        <img src="/images/White-SHAPE-final-Logo-1-1024x431.png" alt="SHAPE" class="x-cover__logo" />
      </div>
      <div class="x-back__body">
        <span class="x-chapter">Section 10</span>
        <h2 class="x-title">Contact</h2>
        <table class="x-table x-table--kv">
          <tbody>
            <tr><th>Website</th><td>{Foot}</td></tr>
            <tr><th>Email</th><td>{contact.email}</td></tr>
            <tr><th>Telephone</th><td>{contact.phone}</td></tr>
            <tr><th>Coordinator</th><td>{coordinator ? `${coordinator.name}, ${coordinator.institution}` : 'Moi University'}</td></tr>
            <tr><th>Website host</th><td>Open University of Kenya</td></tr>
          </tbody>
        </table>
        <div class="x-back__logos">
          <img src="/images/EU-scaled.png" alt="Co-funded by the Erasmus+ Programme of the European Union" />
          <img src="/images/ouk-logo.png" alt="Open University of Kenya" />
        </div>
        <p class="x-disclaimer">{disclaimer}</p>
      </div>
    </section>
  </div>

  <script>
    const sheets = [...document.querySelectorAll<HTMLElement>('.sheet')];
    const indicator = document.querySelector<HTMLElement>('[data-page-indicator]')!;
    const progress = document.querySelector<HTMLElement>('[data-progress]')!;
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
    const toc = document.querySelector<HTMLElement>('[data-toc]')!;
    const tocToggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]')!;

    // Page indicator + active chapter
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          const el = en.target as HTMLElement;
          const i = sheets.indexOf(el);
          indicator.textContent = `${el.dataset.title} · ${i + 1} / ${sheets.length}`;
          tocLinks.forEach((a) => a.classList.toggle('is-active', a.hash === `#${el.id}`));
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sheets.forEach((s) => io.observe(s));

    // Reading progress
    const onScroll = () => {
      const book = document.querySelector<HTMLElement>('.book')!;
      const r = book.getBoundingClientRect();
      const p = Math.min(Math.max(-r.top / (r.height - innerHeight), 0), 1);
      progress.style.width = `${p * 100}%`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Contents drawer
    tocToggle.addEventListener('click', () => {
      const open = toc.classList.toggle('is-open');
      tocToggle.setAttribute('aria-expanded', String(open));
    });
    tocLinks.forEach((a) => a.addEventListener('click', () => { if (innerWidth < 1280) { toc.classList.remove('is-open'); tocToggle.setAttribute('aria-expanded', 'false'); } }));

    // Actions
    document.querySelector('[data-print]')!.addEventListener('click', () => print());
    const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]')!;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href.split('#')[0]);
        copyBtn.querySelector('span')!.textContent = 'Copied!';
        setTimeout(() => (copyBtn.querySelector('span')!.textContent = 'Copy link'), 1800);
      } catch {}
    });

    // Reveal-on-scroll
    const rv = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && e.target.classList.add('is-in')), { threshold: 0.08 });
    sheets.forEach((s) => rv.observe(s));
  </script>
</Base>
