---
import AuthShell from '../../components/admin/AuthShell.astro';
import { clientIp } from '../../lib/analytics';
import { login, SESSION_COOKIE, sessionMaxAge, audit, countUsers } from '../../lib/auth';

const next = Astro.url.searchParams.get('next');
const safeNext = next && next.startsWith('/admin') && !next.startsWith('//') ? next : '/admin';
if (Astro.locals.user) return Astro.redirect(safeNext);

let error = '';
let email = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '');
  const r = login(email, String(form.get('password') ?? ''), { ip: clientIp(Astro.request, Astro.clientAddress), userAgent: Astro.request.headers.get('user-agent') ?? '' });
  if (r.ok) {
    Astro.cookies.set(SESSION_COOKIE, r.token, { path: '/', httpOnly: true, sameSite: 'lax', secure: Astro.url.protocol === 'https:', maxAge: sessionMaxAge });
    audit(r.user.id, r.needsOtp ? 'login.password-ok' : 'login');
    return Astro.redirect(r.needsOtp ? `/admin/otp?next=${encodeURIComponent(safeNext)}` : safeNext, 303);
  }
  error = r.error;
  Astro.response.status = 401;
}
const noUsers = countUsers() === 0;
---

<AuthShell title="Sign in">
  <h1>Sign in to SHAPE CMS</h1>
  <p class="a-sub">Manage the SHAPE project website.</p>
  {noUsers && <p class="a-flash a-flash--err">No accounts exist yet. Create the first admin on the server with <code>npm run create-admin</code>.</p>}
  {error && <p class="a-flash a-flash--err" role="alert">{error}</p>}
  <form method="post" class="a-form">
    <div class="a-field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" required value={email} autofocus /></div>
    <div class="a-field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div>
    <button class="a-btn" type="submit">Sign in</button>
  </form>
</AuthShell>
