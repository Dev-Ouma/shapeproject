---
import Admin from '../../layouts/Admin.astro';
import Lucide from '../../components/Lucide.astro';
import { getLockdown } from '../../lib/system';
import { sendMail } from '../../lib/mail';
import { inviteEmail } from '../../lib/emails';
import { resetOtp, otpEnabled } from '../../lib/otp';
import { listUsers, createInvite, updateUser, listPendingInvites, countActiveAdmins, getUser, audit, findUserByEmail, type Role } from '../../lib/auth';

let error = '';
let inviteLink = '';
let inviteMail = '';
let inviteMailOk = false;
const me = Astro.locals.user!;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action'));
  if (action === 'invite') {
    const email = String(f.get('email') ?? '').trim();
    const name = String(f.get('name') ?? '').trim();
    const role = (f.get('role') === 'admin' ? 'admin' : 'editor') as Role;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !name) error = 'Enter a name and a valid email.';
    else if (findUserByEmail(email)) error = 'A user with that email already exists.';
    else {
      const token = createInvite(email, name, role, me.id);
      inviteLink = `${Astro.url.origin}/admin/invite/${token}`;
      const m = inviteEmail(Astro.url.origin, name, role, inviteLink);
      const sent = await sendMail(email, m.subject, m.text, undefined, m.html);
      inviteMail = sent.ok ? `An invitation email was sent to ${email}.` : `The email could not be sent (${sent.error}) — copy the link below and send it yourself.`;
      inviteMailOk = sent.ok;
      audit(me.id, 'user.invite', `${email} (${role})`, { emailed: sent.ok });
    }
  } else {
    const id = Number(f.get('id'));
    const target = getUser(id);
    if (!target) error = 'User not found.';
    else if (id === me.id) error = 'You cannot change your own role or access here.';
    else if ((action === 'disable' || action === 'editor') && target.role === 'admin' && countActiveAdmins() <= 1) error = 'At least one active admin is required.';
    else {
      if (action === 'disable') updateUser(id, { disabled: true });
      if (action === 'enable') updateUser(id, { disabled: false });
      if (action === 'admin' || action === 'editor') updateUser(id, { role: action });
      if (action === 'reset-otp') resetOtp(id);
      audit(me.id, `user.${action}`, target.email);
      return Astro.redirect('/admin/users?saved=1', 303);
    }
  }
}
const users = listUsers();
const invites = listPendingInvites();
const otpOn = new Map(users.map((u) => [u.id, otpEnabled(u.id)]));
const active = users.filter((u) => !u.disabled);
const summary = [
  { label: 'Active users', value: active.length, icon: 'Users' },
  { label: 'Admins', value: active.filter((u) => u.role === 'admin').length, icon: 'ShieldCheck' },
  { label: 'Editors', value: active.filter((u) => u.role === 'editor').length, icon: 'PenLine' },
  { label: 'Two-step on', value: `${users.filter((u) => otpOn.get(u.id)).length}/${users.length}`, icon: 'KeyRound' },
];
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');
const locked = getLockdown().on;
---

<Admin title="Users" crumbs={[{ label: 'Administration', href: '/admin/system' }, { label: 'Users' }]}>
  {locked && <p class="a-flash a-flash--err" role="status"><strong>Lockdown is active.</strong> Invites, role changes and sign-in resets are locked. <a href="/admin/system/modes">Lift the lockdown</a> to manage users.</p>}
  <fieldset class="a-lockset" disabled={locked}>
  <div class="a-head"><div><h1>Users</h1><p>Admins manage everything. Editors manage content but not users, settings, navigation or redirects.</p></div></div>
  {Astro.url.searchParams.has('saved') && <p class="a-flash a-flash--ok" role="status">Saved.</p>}
  {error && <p class="a-flash a-flash--err" role="alert">{error}</p>}
  {inviteLink && (
    <div class="a-flash a-flash--ok" role="status">
      Invitation created. <span data-invite-mail={inviteMailOk ? 'sent' : 'failed'}>{inviteMail}</span> Link (valid for 7 days, single use):
      <div class="usr-link"><input class="a-input" readonly value={inviteLink} data-invite aria-label="Invitation link" /><button type="button" class="a-btn a-btn--sm" data-copy-invite>Copy</button></div>
    </div>
  )}
  <div class="sys-tiles usr-tiles">
    {summary.map((t) => (
      <div class="a-card sys-tile">
        <span class="sys-tile__ico"><Lucide name={t.icon as any} size={18} /></span>
        <span class="sys-tile__label">{t.label}</span>
        <strong>{t.value}</strong>
      </div>
    ))}
  </div>
  <section class="a-card usr-invite" aria-labelledby="inv-h">
    <h3 id="inv-h"><Lucide name="UserPlus" size={17} /> Invite someone</h3>
    <form method="post" class="usr-invite__form">
      <input type="hidden" name="action" value="invite" />
      <div class="a-field"><label for="iname">Name</label><input id="iname" type="text" name="name" required autocomplete="off" /></div>
      <div class="a-field"><label for="iemail">Email</label><input id="iemail" type="email" name="email" required autocomplete="off" /></div>
      <div class="a-field"><label for="irole">Role</label><select id="irole" name="role"><option value="editor">Editor</option><option value="admin">Admin</option></select></div>
      <button class="a-btn a-btn--coral" type="submit"><Lucide name="Send" size={15} /> Create invite</button>
    </form>
  </section>
  <div class="a-table-wrap">
    <table class="a-table a-table--stack usr-table">
      <thead><tr><th>Person</th><th>Role</th><th>Status</th><th>Two-step</th><th>Last login (UTC)</th><th><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
        {users.map((u) => (
          <tr>
            <td data-label="Person">
              <div class="usr-who">
                <span class="usr-av" aria-hidden="true">{initials(u.name)}</span>
                <span><strong>{u.name}</strong>{u.id === me.id && <span class="a-help"> (you)</span>}<span class="a-help usr-mail">{u.email}</span></span>
              </div>
            </td>
            <td data-label="Role"><span class="a-role">{u.role}</span></td>
            <td data-label="Status">{u.disabled ? <span class="a-pill a-pill--spam">disabled</span> : <span class="a-pill a-pill--published">active</span>}</td>
            <td data-label="Two-step">{otpOn.get(u.id) ? <span class="a-pill a-pill--published">on</span> : <span class="a-pill a-pill--draft">not set up</span>}</td>
            <td data-label="Last login" class="a-help">{u.last_login ?? 'never'}</td>
            <td class="a-row-actions">
              {u.id !== me.id && (
                <form method="post">
                  <input type="hidden" name="id" value={u.id} />
                  {u.role === 'editor' ? <button class="a-btn a-btn--ghost a-btn--sm" name="action" value="admin">Make admin</button> : <button class="a-btn a-btn--ghost a-btn--sm" name="action" value="editor">Make editor</button>}
                  {otpOn.get(u.id) && <button class="a-btn a-btn--ghost a-btn--sm" name="action" value="reset-otp" data-confirm="Reset two-step sign-in? They will set it up again at next login.">Reset 2-step</button>}
                  {u.disabled ? <button class="a-btn a-btn--sm" name="action" value="enable">Enable</button> : <button class="a-btn a-btn--danger a-btn--sm" name="action" value="disable">Disable</button>}
                </form>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {invites.length > 0 && (
    <div class="a-card" style="margin-top:18px"><h3>Pending invitations</h3><ul class="a-list">{invites.map((i) => <li><span>{i.name} — {i.email} <span class="a-role">{i.role}</span></span><small>expires {new Date(i.expires_at).toLocaleDateString('en-GB')}</small></li>)}</ul></div>
  )}
  </fieldset>
</Admin>
<script>
  document.querySelector('[data-copy-invite]')?.addEventListener('click', () => navigator.clipboard.writeText(document.querySelector<HTMLInputElement>('[data-invite]')!.value));
</script>
