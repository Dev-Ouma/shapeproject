# /srv/shape/shared/.env  (chmod 600, owned by shape)
HOST=127.0.0.1
PORT=4321
SITE_URL=https://shapeproject.ouk.ac.ke
DB_PATH=/srv/shape/shared/shape.db
UPLOAD_DIR=/srv/shape/shared/uploads
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
CHROME_PATH=/usr/bin/chromium
# First deploy only — remove after the first admin exists:
# BOOTSTRAP_ADMIN_EMAIL=you@ouk.ac.ke
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_PASSWORD=...
# Outgoing mail (OUK SMTP, STARTTLS on 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SHAPE Website <shape@ouk.ac.ke>"
NOTIFY_EMAIL=shape@ouk.ac.ke

# Search engine ownership verification (meta tag content only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Workspace SMTP relay (server IP allow-listed in the Admin console; no username/password needed):
#   SMTP_HOST=smtp-relay.gmail.com  SMTP_PORT=587  SMTP_FROM="SHAPE Website <shape@ouk.ac.ke>"
# SMTP_HELO=shapeproject.ouk.ac.ke
